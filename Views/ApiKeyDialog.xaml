<Window x:Class="FileRecoveryParser.Views.ApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Keys" Width="480" Height="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E" Foreground="#E0E0E0" FontFamily="Segoe UI">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Google Cloud Vision -->
    <TextBlock Grid.Row="0" Text="Google Cloud Vision API key (required for identification)"
               FontSize="11" Foreground="#9090B0" Margin="0,0,0,6"/>
    <TextBox x:Name="VisionKeyBox" Grid.Row="2"
             Background="#252540" Foreground="#E0E0E0"
             BorderBrush="#3A3A5C" BorderThickness="1"
             Padding="8,6" FontSize="12" FontFamily="Consolas"
             CaretBrush="#E0E0E0"/>

    <!-- TMDB -->
    <TextBlock Grid.Row="4" Text="TMDB API key (optional — enriches results with episode metadata)"
               FontSize="11" Foreground="#9090B0" Margin="0,0,0,6"/>
    <TextBox x:Name="TmdbKeyBox" Grid.Row="6"
             Background="#252540" Foreground="#E0E0E0"
             BorderBrush="#3A3A5C" BorderThickness="1"
             Padding="8,6" FontSize="12" FontFamily="Consolas"
             CaretBrush="#E0E0E0"/>

    <!-- Buttons -->
    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Padding="16,6" BorderThickness="0"
              Background="#252540" Foreground="#9090B0" Cursor="Hand"
              Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Save" Padding="16,6" BorderThickness="0"
              Background="#7C6FF7" Foreground="White" Margin="10,0,0,0" Cursor="Hand"
              Click="Save_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
