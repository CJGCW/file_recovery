<Window x:Class="FileRecoveryParser.Views.DuplicatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:FileRecoveryParser.Converters"
        Title="Duplicate Files"
        Width="820" Height="600" MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">

  <Window.Resources>
    <cv:FileSizeConverter x:Key="FileSizeConverter"/>
    <cv:DateConverter     x:Key="DateConverter"/>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="52"/>
    </Grid.RowDefinitions>

    <!-- ── Header ── -->
    <Border Grid.Row="0" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
            Padding="16,0">
      <Grid>
        <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="13"/>
        <Button x:Name="MarkAllBtn"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Height="28" Padding="12,0" FontSize="12"
                Style="{StaticResource SecondaryButton}"
                Content="Mark All Dupes (Keep Newest)"
                Click="MarkAll_Click"/>
      </Grid>
    </Border>

    <!-- ── Group list ── -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8,12,4">
      <ItemsControl x:Name="GroupsPanel">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,10" CornerRadius="8"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
              <StackPanel>

                <!-- Group header -->
                <Border Background="{StaticResource BgMid}" CornerRadius="8,8,0,0"
                        Padding="12,7" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                  <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" FontSize="12">
                        <Run Text="{Binding Files.Count, Mode=OneWay}"/>
                        <Run Text=" identical files —"/>
                      </TextBlock>
                      <TextBlock FontSize="12" Margin="4,0,0,0"
                                 Foreground="{StaticResource TextSecondary}">
                        <Run Text="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}, Mode=OneWay}"/>
                        <Run Text=" each"/>
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Keep Newest" Height="24" Padding="8,0" FontSize="11"
                              Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                              Tag="{Binding}" Click="KeepNewest_Click"/>
                      <Button Content="Keep Oldest" Height="24" Padding="8,0" FontSize="11"
                              Style="{StaticResource SecondaryButton}"
                              Tag="{Binding}" Click="KeepOldest_Click"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- File rows -->
                <ItemsControl ItemsSource="{Binding Files}" Margin="0,4,0,4">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="10,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="28"/>
                          <ColumnDefinition Width="200" MinWidth="100"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsMarked}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding Record.FileName}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Record.FileName}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" FontSize="11" FontFamily="Consolas"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="{Binding Record.FullPath}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Record.FullPath}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="3" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="{Binding Record.LastModified, Converter={StaticResource DateConverter}}"
                                   VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- ── Footer ── -->
    <Border Grid.Row="2" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,0">
      <Grid>
        <TextBlock x:Name="MarkedCountText" VerticalAlignment="Center"
                   FontSize="12" Foreground="{StaticResource TextSecondary}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="DeleteBtn" Height="30" Padding="14,0"
                  Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                  Content="Delete Marked" IsEnabled="False"
                  Click="DeleteMarked_Click"/>
          <Button Content="Close" Height="30" Padding="14,0"
                  Style="{StaticResource SecondaryButton}"
                  Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
