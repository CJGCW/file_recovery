<Window x:Class="FileRecoveryParser.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileRecoveryParser.ViewModels"
        xmlns:cv="clr-namespace:FileRecoveryParser.Converters"
        xmlns:svc="clr-namespace:FileRecoveryParser.Services"
        Title="File Recovery Parser"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">

  <Window.Resources>
    <cv:FileSizeConverter              x:Key="FileSizeConverter"/>
    <cv:CategoryColorConverter         x:Key="CategoryColorConverter"/>
    <cv:BoolToVisibilityConverter      x:Key="BoolToVis"/>
    <cv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    <cv:SortIndicatorConverter         x:Key="SortIndicator"/>
    <cv:DateConverter                  x:Key="DateConverter"/>
    <cv:DurationConverter              x:Key="DurationConverter"/>
    <cv:StringToBrushConverter         x:Key="StringToBrush"/>

    <!-- DataGrid row style with hover/select. A custom template gives us
         an accent-coloured left bar that's painted only when the row is the
         focused selection — much more visible than just a background tint
         against the already-dark BgDark surface. -->
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <!-- Reserve a 3-pixel slot on the left of every row so the IsSelected
           trigger can paint an accent stripe there without re-laying-out. -->
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridRow">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- Checkbox-selected (bulk selection) — subtle tint, no left bar. -->
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="#2F2F55"/>
        </DataTrigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource RowHover}"/>
        </Trigger>
        <!-- Focus-selected row: brighter purple background + accent left bar.
             This is the trigger that actually highlights the "selected" row
             the user just clicked. Wins over the DataTrigger above because
             it comes later in document order. -->
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#3F3680"/>
          <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"         Value="6,4"/>
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background"      Value="{StaticResource BgPanel}"/>
      <Setter Property="Foreground"      Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Padding"         Value="8,6"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource BgMid}"/>
          <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

  </Window.Resources>

  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/> <!-- title bar (collapses when preview maximized) -->
      <RowDefinition Height="*"/>    <!-- content -->
      <RowDefinition Height="Auto"/> <!-- status bar (collapses when preview maximized) -->
    </Grid.RowDefinitions>

    <!-- ═══════════════════ TITLE BAR ═══════════════════ -->
    <Border Grid.Row="0" Height="56" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
            Visibility="{Binding IsPreviewMaximized, Converter={StaticResource InvBoolToVis}}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
        <TextBlock Text="⟳" FontSize="20" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
        <TextBlock Text="File Recovery Parser" FontSize="16" FontWeight="SemiBold"/>
      </StackPanel>
    </Border>

    <!-- ═══════════════════ MAIN CONTENT ═══════════════════ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="180"/>   <!-- left sidebar -->
        <ColumnDefinition Width="4"/>                    <!-- splitter -->
        <ColumnDefinition Width="*"/>                    <!-- file list -->
        <ColumnDefinition Width="4"/>                    <!-- splitter -->
        <ColumnDefinition Width="260" MinWidth="0"/>     <!-- preview panel -->
      </Grid.ColumnDefinitions>

      <!-- ─── LEFT SIDEBAR ─────────────────────────────────── -->
      <Border Grid.Column="0" Background="{StaticResource BgPanel}"
              BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"
              Visibility="{Binding IsPreviewMaximized, Converter={StaticResource InvBoolToVis}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
          <StackPanel Margin="14,16,14,16">

            <!-- Folder picker -->
            <TextBlock Text="SOURCE FOLDER" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" x:Name="FolderBox"
                       Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Type or paste a folder path"/>
              <Button Grid.Column="2" Content="…" Width="32" Height="32"
                      Style="{StaticResource SecondaryButton}"
                      Click="BrowseFolder_Click" ToolTip="Browse for folder"/>
            </Grid>

            <!-- Excluded folder names — comma-separated, matched by name (case-insensitive) -->
            <TextBlock Text="EXCLUDE FOLDERS" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}" Margin="0,12,0,8"/>
            <TextBox Text="{Binding ExcludedFolderNames, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Comma-separated folder names to skip during scan (matched by name, case-insensitive). Default: rec"/>

            <!-- Delete mode pill toggle. Turns the Scan button below into a bulk-delete button. -->
            <CheckBox Margin="0,10,0,0"
                      IsChecked="{Binding IsDeleteMode}"
                      Cursor="Hand" Focusable="False"
                      ToolTip="Bulk-delete mode. Check the extensions to remove, then click the Delete button.">
              <CheckBox.Template>
                <ControlTemplate TargetType="CheckBox">
                  <StackPanel Orientation="Horizontal" Background="Transparent">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                            Background="#3A3A5C" VerticalAlignment="Center">
                      <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8"
                              Background="White"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="3,0,0,0"/>
                    </Border>
                    <TextBlock x:Name="Label" Text="Delete mode"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"/>
                  </StackPanel>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Track" Property="Background"          Value="#E06C6C"/>
                      <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                      <Setter TargetName="Thumb" Property="Margin"              Value="0,0,3,0"/>
                      <Setter TargetName="Label" Property="Foreground"          Value="#E06C6C"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </CheckBox.Template>
            </CheckBox>

            <Button Margin="0,8,0,0" Height="36" CommandParameter="{Binding FolderPath}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                  <Setter Property="Content" Value="Scan Folder"/>
                  <Setter Property="Command" Value="{Binding ScanCommand}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDeleteMode}" Value="True">
                      <Setter Property="Content"    Value="Delete from folder…"/>
                      <Setter Property="Command"    Value="{Binding DeleteByExtensionsCommand}"/>
                      <Setter Property="Background" Value="#E06C6C"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>

            <!-- Bulk-delete progress (visible only while a delete batch is running) -->
            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6"
                    Background="#220D0D1A"
                    Visibility="{Binding IsDeleting, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <Grid Margin="0,0,0,6">
                  <TextBlock Text="Deleting…" FontSize="11"
                             Foreground="{StaticResource TextSecondary}"
                             HorizontalAlignment="Left"/>
                  <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#E06C6C">
                    <Run Text="{Binding DeleteProgress, Mode=OneWay, StringFormat={}{0:F0}}"/>
                    <Run Text="%"/>
                  </TextBlock>
                </Grid>
                <ProgressBar Value="{Binding DeleteProgress, Mode=OneWay}" Minimum="0" Maximum="100"
                             Height="5" BorderThickness="0">
                  <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                      <Border Background="#33FFFFFF" CornerRadius="3" ClipToBounds="True">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="#E06C6C" CornerRadius="3"/>
                      </Border>
                    </ControlTemplate>
                  </ProgressBar.Template>
                </ProgressBar>
              </StackPanel>
            </Border>

            <Button Content="Cancel" Margin="0,6,0,0" Height="32"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsAnyOperationRunning, Converter={StaticResource BoolToVis}}"/>

            <!-- Progress indicator -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding IsAnyOperationRunning, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="⟳ " Foreground="{StaticResource Accent}">
                <TextBlock.RenderTransform>
                  <RotateTransform x:Name="SpinnerRotate" CenterX="7" CenterY="7"/>
                </TextBlock.RenderTransform>
                <TextBlock.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                         Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:1"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </TextBlock.Triggers>
              </TextBlock>
              <TextBlock Text="Scanning…" Foreground="{StaticResource Accent}" FontSize="12"/>
            </StackPanel>

            <Separator Margin="0,16,0,14" Background="{StaticResource Border}"/>

            <!-- Search -->
            <TextBlock Text="SEARCH" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter by file name or extension"/>

            <Separator Margin="0,16,0,14" Background="{StaticResource Border}"/>

            <!-- ▼ TEXT SEARCH (starts collapsed) -->
            <Expander IsExpanded="False">
              <Expander.Header>
                <TextBlock Text="TEXT SEARCH" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"/>
              </Expander.Header>
              <StackPanel Margin="0,8,0,0">

                <!-- Pattern input -->
                <TextBox Text="{Binding NewSearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Text or regex to find in document/code content">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding AddSearchPatternCommand}"/>
                  </TextBox.InputBindings>
                </TextBox>

                <!-- Options + Add -->
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding NewSearchCaseSensitive}"
                            ToolTip="Case sensitive">
                    <TextBlock Text="Aa" FontFamily="Consolas" FontSize="11"/>
                  </CheckBox>
                  <CheckBox Grid.Column="2" IsChecked="{Binding NewSearchWholeWord}"
                            ToolTip="Whole word only">
                    <TextBlock Text="|W|" FontFamily="Consolas" FontSize="11"/>
                  </CheckBox>
                  <Button Grid.Column="4" Content="Add" Height="26" Padding="10,0"
                          Style="{StaticResource SecondaryButton}"
                          Command="{Binding AddSearchPatternCommand}"/>
                </Grid>

                <!-- Pattern list -->
                <ItemsControl ItemsSource="{Binding SearchPatterns}" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="16"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Symbol}"
                                   Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                   FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <!-- Option badges -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    Margin="4,0" VerticalAlignment="Center">
                          <TextBlock Text="Aa" FontSize="9" FontFamily="Consolas"
                                     Foreground="{StaticResource Accent}" Margin="0,0,3,0">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsCaseSensitive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="|W|" FontSize="9" FontFamily="Consolas"
                                     Foreground="{StaticResource Accent}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsWholeWord}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                        <!-- Remove -->
                        <Button Grid.Column="3" Content="×" Padding="0" FontSize="12"
                                Style="{StaticResource SecondaryButton}" BorderThickness="0"
                                Command="{Binding DataContext.RemoveSearchPatternCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Search + Clear buttons -->
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Content="Search" Height="32"
                          Style="{StaticResource PrimaryButton}"
                          Command="{Binding RunSearchCommand}"/>
                  <Button Grid.Column="2" Content="Clear" Height="32" Padding="10,0"
                          Style="{StaticResource SecondaryButton}"
                          Command="{Binding ClearSearchCommand}"/>
                </Grid>

                <!-- Match count -->
                <TextBlock Margin="0,5,0,0" FontSize="11"
                           Foreground="{StaticResource TextSecondary}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SearchMatchCount}" Value="0">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                  <Run Text="{Binding SearchMatchCount, Mode=OneWay}"/>
                  <Run Text=" file(s) matched"/>
                </TextBlock>

              </StackPanel>
            </Expander>

            <Separator Margin="0,14,0,14" Background="{StaticResource Border}"/>

            <!-- ▼ FILE TYPES -->
            <Expander IsExpanded="True">
              <Expander.Header>
                <Grid HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="FILE TYPES" FontSize="10" FontWeight="SemiBold"
                             Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                  <!-- Master select-all / deselect-all. Label flips based on
                       whether any extension is currently unchecked so the
                       single button covers both directions. -->
                  <Button Grid.Column="1"
                          Command="{Binding ToggleAllFileTypesCommand}"
                          Background="Transparent" BorderThickness="0"
                          Padding="6,0" Cursor="Hand" Focusable="False"
                          ToolTip="Toggle every extension in every category on or off">
                    <TextBlock FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Deselect all"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUncheckedFileType}" Value="True">
                              <Setter Property="Text" Value="Select all"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Button>
                </Grid>
              </Expander.Header>
              <ItemsControl ItemsSource="{Binding FileTypeGroups}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,1,0,0">
                      <!-- Group header row -->
                      <Grid Height="26">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="18"/>  <!-- expand arrow -->
                          <ColumnDefinition Width="18"/>  <!-- master checkbox -->
                          <ColumnDefinition Width="8"/>   <!-- color dot -->
                          <ColumnDefinition Width="4"/>   <!-- gap -->
                          <ColumnDefinition Width="*"/>   <!-- label -->
                        </Grid.ColumnDefinitions>

                        <!-- Expand/collapse arrow button -->
                        <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded}"
                                      Background="Transparent" BorderThickness="0"
                                      Cursor="Hand" Focusable="False" Width="18" Height="18">
                          <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                              <Border Background="Transparent">
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontSize="9" Foreground="{StaticResource TextSecondary}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                      <Setter Property="Text" Value="▶"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                          <Setter Property="Text" Value="▼"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Border>
                            </ControlTemplate>
                          </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Master tri-state checkbox. -->
                        <CheckBox Grid.Column="1" IsThreeState="True"
                                  IsChecked="{Binding IsAllChecked}"
                                  VerticalAlignment="Center"/>

                        <!-- Category color dot -->
                        <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{Binding Category, Converter={StaticResource CategoryColorConverter}}"/>

                        <!-- Category label -->
                        <TextBlock Grid.Column="4" Text="{Binding Label}"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}"/>
                      </Grid>

                      <!-- Per-extension checkboxes, shown when group is expanded -->
                      <ItemsControl Margin="32,0,0,4"
                                    ItemsSource="{Binding Extensions}"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                              <TextBlock Text="{Binding Extension}" FontSize="11"
                                         FontFamily="Consolas"
                                         Foreground="{StaticResource TextSecondary}"/>
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <!-- ▼ IMAGE GROUPS (hidden until images are scanned) -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ImageGroupFilters.Count}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Separator Margin="0,14,0,14" Background="{StaticResource Border}"/>
              <Expander>
                <Expander.Header>
                  <TextBlock Text="IMAGE GROUPS" FontSize="10" FontWeight="SemiBold"
                             Foreground="{StaticResource TextSecondary}"/>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding ImageGroupFilters}" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsChecked}" Margin="0,3">
                        <TextBlock Text="{Binding DisplayLabel}" FontSize="12"/>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>

            <Separator Margin="0,14,0,14" Background="{StaticResource Border}"/>
            <Button Content="Clear Results" Style="{StaticResource SecondaryButton}"
                    Height="30" Command="{Binding ClearCommand}" Margin="0,0,0,6"/>
            <Button Content="Find Duplicates" Style="{StaticResource SecondaryButton}"
                    Height="30" Command="{Binding FindDuplicatesCommand}"/>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    Background="{StaticResource Border}" Cursor="SizeWE"
                    Visibility="{Binding IsPreviewMaximized, Converter={StaticResource InvBoolToVis}}"/>

      <!-- ─── FILE LIST ─────────────────────────────────────── -->
      <Grid Grid.Column="2"
            Visibility="{Binding IsPreviewMaximized, Converter={StaticResource InvBoolToVis}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="36"/>  <!-- results count bar -->
          <RowDefinition Height="36"/>  <!-- action bar -->
          <RowDefinition Height="*"/>   <!-- grid -->
        </Grid.RowDefinitions>

        <!-- Count bar -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Foreground="{StaticResource Accent}" FontWeight="SemiBold">
              <Run Text="{Binding FileCount, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text=" files" Foreground="{StaticResource TextSecondary}"/>
          </StackPanel>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="1" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,0">
          <Grid>
            <!-- Selected count (left) -->
            <TextBlock VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextSecondary}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedCount}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
              <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
              <Run Text=" selected"/>
            </TextBlock>
            <!-- Action buttons (right) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Content="Rename" Height="26" Padding="10,0"
                      Style="{StaticResource SecondaryButton}"
                      Command="{Binding RenameCommand}" Margin="0,0,6,0"/>
              <Button Content="Move to…" Height="26" Padding="10,0"
                      Style="{StaticResource SecondaryButton}"
                      Command="{Binding MoveCommand}" Margin="0,0,6,0"/>
              <Button Content="Delete" Height="26" Padding="10,0"
                      Style="{StaticResource DangerButton}"
                      Command="{Binding DeleteCommand}"
                      Margin="0,0,12,0"/>

              <!-- Scan for tags + auto-apply checkbox -->
              <CheckBox Content="Auto-apply matches"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        IsChecked="{Binding AutoApplyScanResults}"
                        ToolTip="When checked, every match crossing the threshold is added to the file's tag list during the scan."/>
              <Button Content="Scan for tags" Height="26" Padding="10,0"
                      Command="{Binding ScanForTagsCommand}"
                      Style="{StaticResource PrimaryButton}"
                      ToolTip="{Binding ScanForTagsDisabledReason}"
                      Margin="0,0,6,0"/>
              <Button Content="Manage tags…" Height="26" Padding="10,0"
                      Command="{Binding ManageTagsCommand}"
                      Style="{StaticResource SecondaryButton}"
                      Margin="0,0,6,0"
                      ToolTip="Open the tag manager to view, rename, or delete stored frame tags."/>
              <Button Content="View scan results…" Height="26" Padding="10,0"
                      Command="{Binding OpenScanResultsCommand}"
                      Style="{StaticResource SecondaryButton}"
                      Margin="0,0,6,0"
                      ToolTip="Reopen the results window from the most recent scan-for-tags run. Results are kept until the next scan starts."/>
              <!-- Clear sort: hides itself when nothing is sorted so the toolbar isn't cluttered. -->
              <Button Content="Clear sort" Height="26" Padding="10,0"
                      Command="{Binding ClearSortCommand}"
                      Style="{StaticResource SecondaryButton}"
                      Visibility="{Binding IsSorted, Converter={StaticResource BoolToVis}}"
                      ToolTip="Remove the current column-header sort and return the grid to its natural (insertion) order."/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2"
                  x:Name="FileGrid"
                  ItemsSource="{Binding FileView}"
                  SelectedItem="{Binding SelectedFile}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource Border}"
                  Background="{StaticResource BgDark}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  BorderThickness="0"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  EnableColumnVirtualization="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="0">

          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open file location" Command="{Binding OpenLocationCommand}"/>
              <MenuItem Header="Diagnose video…" Command="{Binding DiagnoseVideoCommand}"/>
              <Separator Style="{StaticResource MenuSeparatorStyle}"/>
              <MenuItem Header="Rename…"  Command="{Binding RenameCommand}"/>
              <MenuItem Header="Move to…" Command="{Binding MoveCommand}"/>
              <Separator Style="{StaticResource MenuSeparatorStyle}"/>
              <MenuItem Header="Delete" Command="{Binding DeleteCommand}"
                        Foreground="#E06C6C"/>
            </ContextMenu>
          </DataGrid.ContextMenu>

          <!-- Keep selection highlight when DataGrid loses keyboard focus -->
          <DataGrid.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                             Color="#3A3560"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                             Color="#E8E8F0"/>
          </DataGrid.Resources>

          <DataGrid.Columns>

            <!-- Row selection indicator (▶ triangle) -->
            <DataGridTemplateColumn Width="18" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="▶" FontSize="8"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             Foreground="{StaticResource Accent}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Value="True"
                              Binding="{Binding IsSelected,
                                        RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Checkbox. Explicit Width/Height/Margin override the global
                 CheckBox style's "Margin=0,2" which squashed the box inside
                 the tight 36-pixel column header. -->
            <DataGridTemplateColumn Width="36" CanUserResize="False">
              <DataGridTemplateColumn.HeaderTemplate>
                <DataTemplate>
                  <CheckBox IsThreeState="True"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="18" Height="18" Margin="0"
                            IsChecked="{Binding DataContext.AllSelected, Mode=TwoWay,
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                </DataTemplate>
              </DataGridTemplateColumn.HeaderTemplate>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="18" Height="18" Margin="0"
                            IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Search match indicators -->
            <DataGridTemplateColumn Width="36" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ItemsControl ItemsSource="{Binding MatchedPatterns}" Margin="4,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Symbol}" FontSize="10" Margin="0,0,2,0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"
                                   ToolTip="{Binding Text}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- File name -->
            <DataGridTemplateColumn MinWidth="180" Width="2*">
              <DataGridTemplateColumn.HeaderTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource SecondaryButton}" BorderThickness="0"
                          Background="Transparent" Padding="0"
                          Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="FileName">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="File name" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextSecondary}"/>
                      <TextBlock FontSize="11" Foreground="{StaticResource Accent}">
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource SortIndicator}" ConverterParameter="FileName">
                            <Binding Path="DataContext.SortColumn"    RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                            <Binding Path="DataContext.SortDirection" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.HeaderTemplate>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding FileName}" Padding="6,4"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Category badge -->
            <DataGridTemplateColumn Width="90" MinWidth="80">
              <DataGridTemplateColumn.HeaderTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" BorderThickness="0"
                            Background="Transparent" Padding="0"
                            Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="Category">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Type" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource Accent}">
                          <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource SortIndicator}" ConverterParameter="Category">
                              <Binding Path="DataContext.SortColumn"    RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                              <Binding Path="DataContext.SortDirection" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </Button>
                    <ToggleButton Grid.Column="1" x:Name="CategoryFilterToggle"
                                  Style="{StaticResource ColumnFilterToggle}"
                                  Focusable="False"
                                  Tag="Category"
                                  ToolTip="Filter by file type">
                      <TextBlock Text="▾" FontSize="10"
                                 Foreground="{Binding DataContext.CategoryColumnFilter.IsActive, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource FilterActiveColor}}"/>
                    </ToggleButton>
                    <Popup IsOpen="{Binding ElementName=CategoryFilterToggle, Path=IsChecked, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=CategoryFilterToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                      <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                              BorderThickness="1" CornerRadius="6" Padding="10" Width="240">
                        <Border.Effect>
                          <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Filter values" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                              <Button Content="Select all" FontSize="10" Padding="0" Cursor="Hand"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource Accent}"
                                      Command="{Binding SelectAllColumnValuesCommand}" CommandParameter="Category"/>
                              <TextBlock Text="|" Margin="6,0" Foreground="{StaticResource Border}" VerticalAlignment="Center"/>
                              <Button Content="Deselect all" FontSize="10" Padding="0" Cursor="Hand"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource Accent}"
                                      Command="{Binding DeselectAllColumnValuesCommand}" CommandParameter="Category"/>
                            </StackPanel>
                          </Grid>
                          <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CategoryColumnFilter.Values}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2"/>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                            <Button Content="Clear" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding ClearColumnFilterCommand}" CommandParameter="Category"/>
                            <Button Content="Apply" Style="{StaticResource PrimaryButton}" Padding="10,4"
                                    Command="{Binding ApplyColumnFilterCommand}" CommandParameter="Category"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Popup>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.HeaderTemplate>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="4" Padding="5,2" Margin="4,3" HorizontalAlignment="Left"
                          Background="{Binding Category, Converter={StaticResource CategoryColorConverter}}">
                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold"
                               Foreground="White"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Extension -->
            <DataGridTemplateColumn Width="70" MinWidth="60">
              <DataGridTemplateColumn.HeaderTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" BorderThickness="0"
                            Background="Transparent" Padding="0"
                            Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="Extension">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ext" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource Accent}">
                          <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource SortIndicator}" ConverterParameter="Extension">
                              <Binding Path="DataContext.SortColumn"    RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                              <Binding Path="DataContext.SortDirection" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </Button>
                    <ToggleButton Grid.Column="1" x:Name="ExtFilterToggle"
                                  Style="{StaticResource ColumnFilterToggle}"
                                  Focusable="False"
                                  Tag="Extension"
                                  ToolTip="Filter by extension">
                      <TextBlock Text="▾" FontSize="10"
                                 Foreground="{Binding DataContext.ExtColumnFilter.IsActive, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource FilterActiveColor}}"/>
                    </ToggleButton>
                    <Popup IsOpen="{Binding ElementName=ExtFilterToggle, Path=IsChecked, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ExtFilterToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                      <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                              BorderThickness="1" CornerRadius="6" Padding="10" Width="240">
                        <Border.Effect>
                          <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Filter values" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                              <Button Content="Select all" FontSize="10" Padding="0" Cursor="Hand"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource Accent}"
                                      Command="{Binding SelectAllColumnValuesCommand}" CommandParameter="Extension"/>
                              <TextBlock Text="|" Margin="6,0" Foreground="{StaticResource Border}" VerticalAlignment="Center"/>
                              <Button Content="Deselect all" FontSize="10" Padding="0" Cursor="Hand"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource Accent}"
                                      Command="{Binding DeselectAllColumnValuesCommand}" CommandParameter="Extension"/>
                            </StackPanel>
                          </Grid>
                          <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ExtColumnFilter.Values}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2"/>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                            <Button Content="Clear" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding ClearColumnFilterCommand}" CommandParameter="Extension"/>
                            <Button Content="Apply" Style="{StaticResource PrimaryButton}" Padding="10,4"
                                    Command="{Binding ApplyColumnFilterCommand}" CommandParameter="Extension"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Popup>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.HeaderTemplate>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Extension}" Padding="6,4" FontFamily="Consolas"
                             Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Size -->
            <DataGridTemplateColumn Width="90" MinWidth="70">
              <DataGridTemplateColumn.HeaderTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource SecondaryButton}" BorderThickness="0"
                          Background="Transparent" Padding="0"
                          Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="FileSizeBytes">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Size" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextSecondary}"/>
                      <TextBlock FontSize="11" Foreground="{StaticResource Accent}">
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource SortIndicator}" ConverterParameter="FileSizeBytes">
                            <Binding Path="DataContext.SortColumn"    RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                            <Binding Path="DataContext.SortDirection" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.HeaderTemplate>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}}"
                             Padding="6,4" HorizontalAlignment="Right"
                             Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Length (video/audio only) -->
            <DataGridTemplateColumn Width="80" MinWidth="70" Header="Length">
              <DataGridTemplateColumn.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="Length" FontSize="11" FontWeight="SemiBold"
                             Foreground="{StaticResource TextSecondary}" Padding="8,6"/>
                </DataTemplate>
              </DataGridTemplateColumn.HeaderTemplate>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Duration, Converter={StaticResource DurationConverter}}"
                             Padding="6,4" HorizontalAlignment="Right"
                             Foreground="{StaticResource TextSecondary}" FontSize="12"
                             FontFamily="Consolas"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Tags -->
            <DataGridTemplateColumn Width="160" MinWidth="80">
              <DataGridTemplateColumn.HeaderTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" BorderThickness="0"
                            Background="Transparent" Padding="0"
                            Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="TagsSortKey">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tags" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource Accent}">
                          <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource SortIndicator}" ConverterParameter="TagsSortKey">
                              <Binding Path="DataContext.SortColumn"    RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                              <Binding Path="DataContext.SortDirection" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </Button>
                    <ToggleButton Grid.Column="1" x:Name="TagsFilterToggle"
                                  Style="{StaticResource ColumnFilterToggle}"
                                  Focusable="False"
                                  Tag="Tags"
                                  ToolTip="Filter by tag">
                      <TextBlock Text="▾" FontSize="10"
                                 Foreground="{Binding DataContext.TagsColumnFilter.IsActive, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource FilterActiveColor}}"/>
                    </ToggleButton>
                    <Popup IsOpen="{Binding ElementName=TagsFilterToggle, Path=IsChecked, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=TagsFilterToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                      <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                              BorderThickness="1" CornerRadius="6" Padding="10" Width="240">
                        <Border.Effect>
                          <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Filter values" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                              <Button Content="Select all" FontSize="10" Padding="0" Cursor="Hand"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource Accent}"
                                      Command="{Binding SelectAllColumnValuesCommand}" CommandParameter="Tags"/>
                              <TextBlock Text="|" Margin="6,0" Foreground="{StaticResource Border}" VerticalAlignment="Center"/>
                              <Button Content="Deselect all" FontSize="10" Padding="0" Cursor="Hand"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource Accent}"
                                      Command="{Binding DeselectAllColumnValuesCommand}" CommandParameter="Tags"/>
                            </StackPanel>
                          </Grid>
                          <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TagsColumnFilter.Values}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2"/>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                            <Button Content="Clear" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding ClearColumnFilterCommand}" CommandParameter="Tags"/>
                            <Button Content="Apply" Style="{StaticResource PrimaryButton}" Padding="10,4"
                                    Command="{Binding ApplyColumnFilterCommand}" CommandParameter="Tags"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Popup>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.HeaderTemplate>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ItemsControl ItemsSource="{Binding Tags}" Margin="4,3">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,3,0" Padding="5,1" CornerRadius="3"
                                Background="{Binding Color, Converter={StaticResource StringToBrush}}">
                          <TextBlock Text="{Binding Name}" FontSize="9" Foreground="White"/>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Full path -->
            <DataGridTemplateColumn Width="3*" MinWidth="200">
              <DataGridTemplateColumn.HeaderTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource SecondaryButton}" BorderThickness="0"
                          Background="Transparent" Padding="0"
                          Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="FullPath">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Path" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextSecondary}"/>
                      <TextBlock FontSize="11" Foreground="{StaticResource Accent}">
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource SortIndicator}" ConverterParameter="FullPath">
                            <Binding Path="DataContext.SortColumn"    RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                            <Binding Path="DataContext.SortDirection" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.HeaderTemplate>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding FullPath}" Padding="6,4"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"
                             Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

          </DataGrid.Columns>
        </DataGrid>

        <!-- Scan overlay — blocks action bar + grid while scanning is in progress -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="50" IsHitTestVisible="True"
              Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
          <Rectangle Fill="{StaticResource BgDark}" Opacity="0.55"/>
        </Grid>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding FileCount}" Value="0"/>
                    <Condition Binding="{Binding IsNotScanning}" Value="True"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
          <TextBlock Text="No files loaded" FontSize="18" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <TextBlock Text="Choose a folder and click Scan Folder to begin."
                     Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
        </StackPanel>

      </Grid>

      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                    Background="{StaticResource Border}" Cursor="SizeWE"
                    Visibility="{Binding IsPreviewMaximized, Converter={StaticResource InvBoolToVis}}"/>

      <!-- ─── PREVIEW PANEL ─────────────────────────────────── -->
      <Border Background="{StaticResource BgPanel}"
              BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Grid.Column"     Value="4"/>
            <Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Panel.ZIndex"    Value="0"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPreviewMaximized}" Value="True">
                <Setter Property="Grid.Column"     Value="0"/>
                <Setter Property="Grid.ColumnSpan" Value="5"/>
                <Setter Property="Panel.ZIndex"    Value="100"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Preview panel header (maximize button) -->
          <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                  BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                  Padding="10,6"
                  Visibility="{Binding ShowAnyPreview, Converter={StaticResource BoolToVis}}">
            <Grid>
              <TextBlock Text="PREVIEW" FontSize="10" FontWeight="SemiBold"
                         Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
              <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                      Height="22" Padding="8,0" FontSize="11"
                      Command="{Binding TogglePreviewMaximizeCommand}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                    <Setter Property="Content" Value="⤢  Expand"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPreviewMaximized}" Value="True">
                        <Setter Property="Content" Value="⤡  Restore"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </Grid>
          </Border>

          <!-- Preview content (row 1) -->
          <Grid Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>  <!-- thumbnail strip -->
              <RowDefinition Height="Auto"/>  <!-- timeline scrubber -->
              <RowDefinition Height="Auto"/>  <!-- metadata + suggestions -->
            </Grid.RowDefinitions>

          <!-- No selection placeholder (row 0) -->
          <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding ShowMetadata, Converter={StaticResource InvBoolToVis}}">
            <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Select a file" FontSize="13"
                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
            <TextBlock Text="to preview it here." FontSize="13"
                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
          </StackPanel>

          <!-- Image or document preview (row 0) -->
          <Border Grid.Row="0" Margin="12,12,12,8" CornerRadius="8"
                  Background="{StaticResource BgMid}"
                  Visibility="{Binding ShowAnyPreview, Converter={StaticResource BoolToVis}}">
            <Grid>
              <!-- Image + face overlay scale together via the Viewbox -->
              <Viewbox Stretch="Uniform" Margin="8"
                       Visibility="{Binding ShowMediaPreview, Converter={StaticResource BoolToVis}}">
                <Grid Width="{Binding PreviewImagePixelWidth}"
                      Height="{Binding PreviewImagePixelHeight}">
                  <Image Source="{Binding PreviewImage}"
                         Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>

                  <!-- Manual region selection layer (drag to draw, right-click box to tag).
                       Background=Transparent so it catches mouse on empty image areas
                       (face boxes above this still receive their own clicks). -->
                  <Canvas x:Name="ManualRegionLayer" Background="Transparent"
                          Visibility="{Binding ShowImagePreview, Converter={StaticResource BoolToVis}}"
                          MouseLeftButtonDown="ManualRegion_MouseDown"
                          MouseMove="ManualRegion_MouseMove"
                          MouseLeftButtonUp="ManualRegion_MouseUp"/>

                  <!-- Detected face boxes — only visible for images -->
                  <ItemsControl ItemsSource="{Binding DetectedFaces}"
                                Visibility="{Binding ShowImagePreview, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Width="{Binding Width}" Height="{Binding Height}">
                          <Border BorderBrush="{StaticResource Accent}"
                                  BorderThickness="3" CornerRadius="4"
                                  Background="#22FFFFFF" Cursor="Hand"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Border.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Tag face…"
                                          Command="{Binding PlacementTarget.Tag.TagFaceCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                              </ContextMenu>
                            </Border.ContextMenu>
                          </Border>
                          <!-- Name label, only shown when present -->
                          <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                  Padding="6,2" Margin="0,0,0,-2"
                                  Background="{StaticResource Accent}" CornerRadius="3"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                       Foreground="White" FontWeight="SemiBold"/>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Viewbox>
              <svc:PreviewHandlerHost FilePath="{Binding PreviewFilePath}"
                     Visibility="{Binding ShowDocumentPreview, Converter={StaticResource BoolToVis}}"/>
              <!-- Inline plain-text preview for .txt and other text-like
                   extensions. The Shell preview-handler path is fragile on
                   these (often missing or 32-bit), so we just read the file
                   and display it directly. Read-only TextBox so the user
                   can still select + copy text. -->
              <TextBox Text="{Binding TextPreviewContent, Mode=OneWay}"
                       Visibility="{Binding ShowTextPreview, Converter={StaticResource BoolToVis}}"
                       IsReadOnly="True"
                       FontFamily="Consolas" FontSize="12"
                       Background="{StaticResource BgPanel}"
                       Foreground="{StaticResource TextPrimary}"
                       BorderThickness="0"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       TextWrapping="NoWrap"
                       AcceptsReturn="True"
                       Padding="12"/>
              <!-- Deep-scan progress overlay -->
              <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                      Margin="12,0,12,12" Padding="10,8" CornerRadius="6"
                      Background="#CC0D0D1A"
                      Visibility="{Binding IsDeepScanning, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="Deep scanning…" FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Left"/>
                    <TextBlock HorizontalAlignment="Right" FontSize="11"
                               Foreground="{StaticResource Accent}">
                      <Run Text="{Binding DeepScanProgress, Mode=OneWay, StringFormat={}{0:F0}}"/>
                      <Run Text="%"/>
                    </TextBlock>
                  </Grid>
                  <!-- Progress bar -->
                  <ProgressBar Value="{Binding DeepScanProgress, Mode=OneWay}" Minimum="0" Maximum="100"
                               Height="5" BorderThickness="0">
                    <ProgressBar.Template>
                      <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#33FFFFFF" CornerRadius="3" ClipToBounds="True">
                          <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                  Background="{StaticResource Accent}" CornerRadius="3"/>
                        </Border>
                      </ControlTemplate>
                    </ProgressBar.Template>
                  </ProgressBar>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

            <!-- Thumbnail strip (row 1 — video only) -->
            <Border Grid.Row="1" Margin="12,0,12,6" CornerRadius="8"
                    Background="{StaticResource BgMid}"
                    Visibility="{Binding ShowThumbnailStrip, Converter={StaticResource BoolToVis}}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Hidden"
                            Padding="4,6"
                            x:Name="ThumbnailStripScroller">
                <ItemsControl ItemsSource="{Binding ThumbnailStrip}"
                              x:Name="ThumbnailStripItems">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Margin="3,0" Padding="0" BorderThickness="0"
                              Background="Transparent" Cursor="Hand"
                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                              Command="{Binding DataContext.SelectThumbnailCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Tag this frame…"
                                      Command="{Binding PlacementTarget.Tag.TagFrameCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Border CornerRadius="4" BorderThickness="2" Width="116" Height="80">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="BorderBrush" Value="Transparent"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid ClipToBounds="True">
                            <Image Source="{Binding Image}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- Timestamp label overlaid at bottom -->
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Padding="4,1" Margin="0,0,0,4" CornerRadius="3"
                                    Background="#CC000000">
                              <TextBlock Text="{Binding Label}" FontSize="9"
                                         Foreground="White" FontFamily="Consolas"/>
                            </Border>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>

            <!-- Timeline scrubber (row 2 — video only) -->
            <Border Grid.Row="2" Margin="12,0,12,4" Padding="8,7" CornerRadius="8"
                    Background="{StaticResource BgMid}"
                    Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVis}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="0:00" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider Grid.Column="1"
                        Minimum="0" Maximum="{Binding TimelineMax}"
                        Value="{Binding TimelineValue}"
                        VerticalAlignment="Center"
                        IsMoveToPointEnabled="True"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding TimelineLabel}"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource Accent}"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
              </Grid>
            </Border>

            <!-- File metadata (row 3 — shown for any selected file) -->
            <Border Grid.Row="3" Margin="12,0,12,12" Padding="12"
                    Background="{StaticResource BgMid}" CornerRadius="8"
                    Visibility="{Binding ShowMetadata, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="{Binding SelectedFile.FileName}"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <!-- Document title (only shown when present) -->
                <Grid Margin="0,2">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile.DocumentTitle}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Title" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                  <TextBlock Grid.Column="1" FontSize="12"
                             Text="{Binding SelectedFile.DocumentTitle}" TextWrapping="Wrap"/>
                </Grid>
                <!-- Video title (embedded or filename-parsed) -->
                <Grid Margin="0,2">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile.VideoInfo.BestTitle}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Title" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                  <TextBlock Grid.Column="1" FontSize="12"
                             Text="{Binding SelectedFile.VideoInfo.BestTitle}" TextWrapping="Wrap"/>
                </Grid>
                <!-- Episode label S01E02 -->
                <Grid Margin="0,2">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile.VideoInfo.EpisodeLabel}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Episode" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                  <TextBlock Grid.Column="1" FontSize="12" FontFamily="Consolas"
                             Foreground="{StaticResource Accent}"
                             Text="{Binding SelectedFile.VideoInfo.EpisodeLabel}"/>
                </Grid>
                <!-- Resolution -->
                <Grid Margin="0,2">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile.VideoInfo.Resolution}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Resolution" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                  <TextBlock Grid.Column="1" FontSize="12" FontFamily="Consolas"
                             Text="{Binding SelectedFile.VideoInfo.Resolution}"/>
                </Grid>
                <!-- Year (embedded metadata) -->
                <Grid Margin="0,2">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile.VideoInfo.Year}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Year" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                  <TextBlock Grid.Column="1" FontSize="12" Text="{Binding SelectedFile.VideoInfo.Year}"/>
                </Grid>

                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Size" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                  <TextBlock Grid.Column="1" FontSize="12"
                             Text="{Binding SelectedFile.FileSizeBytes, Converter={StaticResource FileSizeConverter}}"/>
                </Grid>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Modified" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                  <TextBlock Grid.Column="1" FontSize="12"
                             Text="{Binding SelectedFile.LastModified, Converter={StaticResource DateConverter}}"/>
                </Grid>
                <!-- Duration (video/audio only) -->
                <Grid Margin="0,2">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFile.Duration}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Length" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                  <TextBlock Grid.Column="1" FontSize="12"
                             Text="{Binding SelectedFile.Duration, Converter={StaticResource DurationConverter}}"/>
                </Grid>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="MIME" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                  <TextBlock Grid.Column="1" FontSize="11" FontFamily="Consolas"
                             Text="{Binding SelectedFile.DetectedMimeType}"
                             TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Path" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                  <TextBlock Grid.Column="1" FontSize="11" FontFamily="Consolas"
                             Text="{Binding SelectedFile.FullPath}"
                             TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                </Grid>

                <!-- Tags -->
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Text="TAGS" FontSize="10" FontWeight="SemiBold"
                             Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                  <!-- Applied tags -->
                  <ItemsControl ItemsSource="{Binding SelectedFile.Tags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,4,4" Padding="6,2" CornerRadius="4"
                                Background="{Binding Color, Converter={StaticResource StringToBrush}}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White"/>
                            <Button Content="×" Margin="4,0,0,0" Padding="0"
                                    FontSize="11" Foreground="White"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.RemoveTagCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- AI-suggested tags -->
                  <StackPanel Margin="0,4,0,0">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SuggestedTags.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Suggested:" FontSize="10"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding SuggestedTags}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Margin="0,0,4,4" Padding="6,2" Height="22"
                                  Style="{StaticResource SecondaryButton}"
                                  Content="{Binding}"
                                  Command="{Binding DataContext.AddTagCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <!-- Add tag input — with autocomplete popup -->
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="NewTagBox"
                             Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Type a tag name. Press Enter to add as new, or click a suggestion below.">
                      <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding CreateAndAddTagCommand}"/>
                      </TextBox.InputBindings>
                    </TextBox>
                    <Popup IsOpen="{Binding IsTagSuggestionsOpen, Mode=OneWay}"
                           PlacementTarget="{Binding ElementName=NewTagBox}"
                           Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
                           Focusable="False">
                      <Border Background="{StaticResource BgPanel}"
                              BorderBrush="{StaticResource Border}"
                              BorderThickness="1" CornerRadius="6" Padding="2"
                              MinWidth="{Binding ElementName=NewTagBox, Path=ActualWidth}">
                        <Border.Effect>
                          <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <ItemsControl ItemsSource="{Binding TagSuggestions}" KeyboardNavigation.TabNavigation="Continue">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button HorizontalContentAlignment="Left" Padding="6,3" Margin="0"
                                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                                      Command="{Binding DataContext.AcceptTagSuggestionCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}">
                                <Button.Template>
                                  <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                      <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BgMid}"/>
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                  <Border CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                          Background="{Binding Color, Converter={StaticResource StringToBrush}}">
                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="White"/>
                                  </Border>
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </Popup>
                    <Button Grid.Column="2" Content="+" Height="28"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreateAndAddTagCommand}"/>
                  </Grid>
                </StackPanel>

                <!-- Tag selected frame (visual fingerprint) -->
                <Button Margin="0,6,0,0"
                        Command="{Binding TagSelectedFrameCommand}"
                        Height="28" HorizontalAlignment="Stretch"
                        BorderThickness="0" Cursor="Hand"
                        Background="#3A3A5C" Foreground="{StaticResource TextPrimary}" FontSize="12"
                        Content="Tag selected frame…"
                        ToolTip="Save the selected frame's visual fingerprint with a tag. The tag will be proposed when matching frames appear in other files."
                        Visibility="{Binding ShowVideoPreview, Converter={StaticResource BoolToVis}}"/>

                <!-- Deep Scan -->
                <Grid Margin="0,12,0,0">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowVideoPreview}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Button Command="{Binding DeepScanCommand}"
                          Height="28" HorizontalAlignment="Stretch"
                          BorderThickness="0" Cursor="Hand"
                          Background="#3A3A5C" Foreground="{StaticResource TextPrimary}" FontSize="12">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Content" Value="Deep Scan (every second, 10 min)"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDeepScanning}" Value="True">
                            <Setter Property="Content" Value="Scanning…"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </Grid>

                <!-- Identify -->
                <Button Margin="0,6,0,0"
                        Command="{Binding IdentifyEpisodeCommand}"
                        Height="28" HorizontalAlignment="Stretch"
                        BorderThickness="0" Cursor="Hand"
                        Background="#7C6FF7" Foreground="White" FontSize="12">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="Content" Value="Identify"/>
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowVideoPreview}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsIdentifying}" Value="True">
                          <Setter Property="Content" Value="Identifying..."/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>

                <!-- Identify Icon -->
                <Button Margin="0,8,0,0"
                        Command="{Binding IdentifyIconCommand}"
                        Height="28" HorizontalAlignment="Stretch"
                        BorderThickness="0" Cursor="Hand"
                        Background="#5B8DD9" Foreground="White" FontSize="12">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="Content" Value="Identify Icon"/>
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowIconIdentify}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsIdentifying}" Value="True">
                          <Setter Property="Content" Value="Identifying..."/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>

                <!-- Suggestions -->
                <StackPanel Margin="0,10,0,0">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentSuggestions.Count}" Value="0">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Text="SUGGESTIONS" FontSize="10" FontWeight="SemiBold"
                             Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                  <ItemsControl ItemsSource="{Binding CurrentSuggestions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                                Background="{StaticResource BgDark}">
                          <Grid>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Source + confidence -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                              <Border Padding="4,1" CornerRadius="3"
                                      Background="{StaticResource Accent}">
                                <TextBlock Text="{Binding Source}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="White"/>
                              </Border>
                              <TextBlock Margin="6,0,0,0" FontSize="11"
                                         Foreground="{StaticResource TextSecondary}">
                                <Run Text="{Binding Confidence, StringFormat={}{0:P0}}"/>
                                <Run Text=" match"/>
                              </TextBlock>
                            </StackPanel>
                            <!-- Suggested name -->
                            <TextBlock Grid.Row="1" FontSize="12" FontWeight="SemiBold"
                                       Text="{Binding SuggestedName}" TextWrapping="Wrap"
                                       Margin="0,2,32,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Visible"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuggestedName}" Value="{x:Null}">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <!-- Suggested folder -->
                            <TextBlock Grid.Row="2" FontSize="10" FontFamily="Consolas"
                                       Text="{Binding SuggestedFolder}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,2,32,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Visible"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuggestedFolder}" Value="{x:Null}">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <!-- Apply -->
                            <Button Grid.Row="0" Grid.RowSpan="3"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Content="Apply" Height="22" Padding="8,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DataContext.ApplySuggestionCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

              </StackPanel>
            </Border>

          </Grid><!-- /preview content row -->

        </Grid><!-- /layout grid -->
      </Border><!-- /preview panel -->

    </Grid>

    <!-- ═══════════════════ STATUS BAR ═══════════════════ -->
    <Border Grid.Row="2" Height="28" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,0"
            Visibility="{Binding IsPreviewMaximized, Converter={StaticResource InvBoolToVis}}">
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                 FontSize="12" Foreground="{StaticResource TextSecondary}"/>
    </Border>

    <!-- Modal overlay during Scan-for-tags. Locks the whole window. -->
    <Grid Grid.Row="0" Grid.RowSpan="3" Background="#CC0D0D1A" Panel.ZIndex="999"
          Visibility="{Binding IsScanningForTags, Converter={StaticResource BoolToVis}}">
      <Border Background="{StaticResource BgPanel}" CornerRadius="10"
              BorderBrush="{StaticResource Border}" BorderThickness="1"
              Padding="28,24" Width="520"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="Scanning for tags…" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
          <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16">
            <Run Text="{Binding ScanFilesDone, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding ScanFilesTotal, Mode=OneWay}"/><Run Text=" files complete"/>
          </TextBlock>
          <ProgressBar Value="{Binding ScanProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                       Height="6" BorderThickness="0" Margin="0,0,0,12">
            <ProgressBar.Template>
              <ControlTemplate TargetType="ProgressBar">
                <Border Background="#33FFFFFF" CornerRadius="3" ClipToBounds="True">
                  <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                          Background="{StaticResource Accent}" CornerRadius="3"/>
                </Border>
              </ControlTemplate>
            </ProgressBar.Template>
          </ProgressBar>
          <TextBlock Text="{Binding ScanCurrentFile}" FontSize="11"
                     Foreground="{StaticResource TextSecondary}" FontFamily="Consolas"
                     TextTrimming="CharacterEllipsis" Margin="0,0,0,18"/>
          <Button Content="Cancel" Height="30" Padding="16,0"
                  HorizontalAlignment="Right"
                  Style="{StaticResource SecondaryButton}"
                  Command="{Binding CancelScanForTagsCommand}"/>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</Window>
