<Window x:Class="FileRecoveryParser.Views.ScanResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:FileRecoveryParser.Converters"
        xmlns:local="clr-namespace:FileRecoveryParser.Views"
        Title="Scan results"
        Width="1100" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E" Foreground="#E0E0E0" FontFamily="Segoe UI">
  <Window.Resources>
    <cv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
    <cv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static local:ScanResultsWindow.EditTagCommand}"
                    Executed="EditTag_Executed"/>
  </Window.CommandBindings>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Toolbar: filter + apply all -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0" x:Name="FilterBox"
               Background="#252540" Foreground="#E0E0E0"
               BorderBrush="#3A3A5C" BorderThickness="1"
               Padding="8,6" FontSize="12"
               CaretBrush="#E0E0E0"
               TextChanged="FilterBox_TextChanged"
               ToolTip="Filter by file name or tag"/>
      <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,6"
              Content="Apply all visible"
              Background="#7C6FF7" Foreground="White"
              BorderThickness="0" Cursor="Hand"
              Click="ApplyAll_Click"/>
    </Grid>

    <!-- Results grid -->
    <DataGrid Grid.Row="2" x:Name="ResultsGrid"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="#2A2A3E"
              Background="#1A1A2E"
              Foreground="#E0E0E0"
              BorderBrush="#3A3A5C"
              RowBackground="Transparent"
              AlternatingRowBackground="#1F1F2E"
              RowHeight="64">
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background"       Value="#252540"/>
          <Setter Property="Foreground"       Value="#E8E8F0"/>
          <Setter Property="FontWeight"       Value="SemiBold"/>
          <Setter Property="FontSize"         Value="12"/>
          <Setter Property="Padding"          Value="10,8"/>
          <Setter Property="BorderBrush"      Value="#3A3A5C"/>
          <Setter Property="BorderThickness"  Value="0,0,1,1"/>
          <Setter Property="HorizontalContentAlignment" Value="Left"/>
          <Setter Property="Cursor"           Value="Hand"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="DataGridColumnHeader">
                <Grid Background="{TemplateBinding Background}">
                  <Border BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                    <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center"/>
                      <TextBlock x:Name="SortArrow" Margin="6,0,0,0" FontSize="10"
                                 Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="SortDirection" Value="Ascending">
                    <Setter TargetName="SortArrow" Property="Text" Value="↑"/>
                  </Trigger>
                  <Trigger Property="SortDirection" Value="Descending">
                    <Setter TargetName="SortArrow" Property="Text" Value="↓"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E2E48"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.CellStyle>
        <Style TargetType="DataGridCell">
          <Setter Property="Background"       Value="Transparent"/>
          <Setter Property="BorderThickness"  Value="0"/>
          <Setter Property="Padding"          Value="6,4"/>
          <Setter Property="Foreground"       Value="#E0E0E0"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="#2E2E48"/>
              <Setter Property="Foreground" Value="#E0E0E0"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </DataGrid.CellStyle>
      <DataGrid.Columns>
        <!-- Thumbnail -->
        <DataGridTemplateColumn Header="Thumbnail" Width="120" SortMemberPath="MatchStrength">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid>
                <!-- Normal thumbnail. Visible when we have PNG bytes. -->
                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                       Margin="4" RenderOptions.BitmapScalingMode="HighQuality">
                  <Image.ToolTip>
                    <Image Source="{Binding Thumbnail}" Width="420"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Image.ToolTip>
                </Image>
                <!-- "Cached" badge for hits produced from ScannedVideoStore
                     without a live decode. No thumbnail bytes available
                     because we never re-launched ffmpeg for this video. -->
                <Border Background="#252540" BorderBrush="#3A3A5C" BorderThickness="1"
                        CornerRadius="4" Padding="6,4" Margin="4"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip="This match came from the persistent hash cache. Re-run scan with the file selected to capture a thumbnail.">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding FromCache}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel Orientation="Vertical">
                    <TextBlock Text="cached" FontSize="10" Foreground="#9090B0"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="no thumbnail" FontSize="9" Foreground="#5A5A7C"
                               HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="File" Width="*" Binding="{Binding FileName}"
                            IsReadOnly="True"/>

        <!-- Tag column: editable inline. Right-click → "Edit tag…" puts the
             cell into edit mode so the user can correct a wrong match before
             applying it. Two-way binding updates ScanResult.TagName which
             ApplyScanResult reads at apply time. SortMemberPath/CanUserSort
             are set explicitly because the auto-derived sort key from a
             two-way binding doesn't always survive header-click sorting. -->
        <DataGridTextColumn Header="Tag" Width="200" x:Name="TagColumn"
                            Binding="{Binding TagName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SortMemberPath="TagName"
                            CanUserSort="True">
          <DataGridTextColumn.CellStyle>
            <Style TargetType="DataGridCell">
              <Setter Property="Background"       Value="Transparent"/>
              <Setter Property="BorderThickness"  Value="0"/>
              <Setter Property="Padding"          Value="6,4"/>
              <Setter Property="Foreground"       Value="#E0E0E0"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="ContextMenu">
                <Setter.Value>
                  <ContextMenu>
                    <MenuItem Header="Edit tag…"
                              Command="{x:Static local:ScanResultsWindow.EditTagCommand}"
                              CommandParameter="{Binding}"/>
                  </ContextMenu>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#2E2E48"/>
                  <Setter Property="Foreground" Value="#E0E0E0"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGridTextColumn.CellStyle>
        </DataGridTextColumn>

        <!-- Strength uses the bucketed rating word; sort still ordered by the
             raw MatchStrength score so "Excellent" rows float to the top. The
             cell ToolTip surfaces the underlying technical label. -->
        <DataGridTextColumn Header="Strength" Width="110"
                            Binding="{Binding MatchStrengthRating}"
                            SortMemberPath="MatchStrength"
                            IsReadOnly="True">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="ToolTip" Value="{Binding MatchStrengthLabel}"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>

        <!-- Apply / Applied state -->
        <DataGridTemplateColumn Header="" Width="100">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid>
                <Button Content="Apply" Padding="10,2" Cursor="Hand"
                        Background="#3A3A5C" Foreground="White" BorderThickness="0"
                        Click="ApplyOne_Click"
                        Visibility="{Binding IsApplied, Converter={StaticResource InvBoolToVis}}"/>
                <TextBlock Text="✓ applied" Foreground="#6CBF6C"
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"
                           Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}"/>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" x:Name="StatusLine"
                 Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="Close" Padding="20,6" Cursor="Hand"
              Background="#3A3A5C" Foreground="#E0E0E0" BorderThickness="0"
              Click="Close_Click"/>
    </Grid>
  </Grid>
</Window>
