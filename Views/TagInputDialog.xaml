<Window x:Class="FileRecoveryParser.Views.TagInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag frame" Width="400" Height="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E" Foreground="#E0E0E0" FontFamily="Segoe UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="PromptLabel" Grid.Row="0"
               Text="Tag this frame as:"
               FontSize="12" Foreground="#9090B0"/>

    <TextBox x:Name="TagNameBox" Grid.Row="2"
             Background="#252540" Foreground="#E0E0E0"
             BorderBrush="#3A3A5C" BorderThickness="1"
             Padding="8,6" FontSize="13" FontFamily="Segoe UI"
             CaretBrush="#E0E0E0">
      <TextBox.InputBindings>
        <KeyBinding Key="Return" Command="ApplicationCommands.NotACommand"/>
      </TextBox.InputBindings>
    </TextBox>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Padding="16,6" BorderThickness="0"
              Background="#252540" Foreground="#9090B0" Cursor="Hand"
              Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Save" Padding="16,6" BorderThickness="0"
              Background="#7C6FF7" Foreground="White" Margin="10,0,0,0" Cursor="Hand"
              Click="Save_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
