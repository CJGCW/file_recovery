<Window x:Class="FileRecoveryParser.Views.TagManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:FileRecoveryParser.Converters"
        Title="Tag management"
        Width="1100" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E" Foreground="#E0E0E0" FontFamily="Segoe UI">
  <Window.Resources>
    <cv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
    <cv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0" x:Name="FilterBox"
               Background="#252540" Foreground="#E0E0E0"
               BorderBrush="#3A3A5C" BorderThickness="1"
               Padding="8,6" FontSize="12"
               CaretBrush="#E0E0E0"
               TextChanged="FilterBox_TextChanged"
               ToolTip="Filter by tag name or source file"/>
      <CheckBox Grid.Column="1" x:Name="OrphansOnly"
                Content="Orphans only" Margin="12,0,0,0"
                Foreground="#E0E0E0" VerticalAlignment="Center"
                Checked="Filter_Changed" Unchecked="Filter_Changed"
                ToolTip="Show only tags whose source file no longer exists"/>
      <TextBlock Grid.Column="2" Text="Group by:" Margin="16,0,6,0"
                 Foreground="#9090B0" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="3" x:Name="GroupByBox" Width="150"
                Background="#252540" Foreground="#E0E0E0"
                BorderBrush="#3A3A5C" BorderThickness="1"
                SelectedIndex="0" SelectionChanged="GroupBy_Changed">
        <ComboBoxItem Content="None"        Foreground="#E0E0E0" Background="#252540"/>
        <ComboBoxItem Content="Tag name"    Foreground="#E0E0E0" Background="#252540"/>
        <ComboBoxItem Content="Source file" Foreground="#E0E0E0" Background="#252540"/>
        <ComboBoxItem Content="Date added"  Foreground="#E0E0E0" Background="#252540"/>
        <ComboBoxItem Content="Thumbnail"   Foreground="#E0E0E0" Background="#252540"/>
      </ComboBox>
      <Button Grid.Column="4" Margin="10,0,0,0" Padding="14,6"
              Content="Add image…"
              Background="#3A3A5C" Foreground="White"
              BorderThickness="0" Cursor="Hand"
              Click="AddImage_Click"
              ToolTip="Add an image file (poster / logo / portrait) as a tag fingerprint"/>
      <Button Grid.Column="5" Margin="6,0,0,0" Padding="14,6"
              Content="Delete selected"
              Background="#E06C6C" Foreground="White"
              BorderThickness="0" Cursor="Hand"
              Click="DeleteSelected_Click"/>
    </Grid>

    <DataGrid Grid.Row="2" x:Name="TagsGrid"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="#2A2A3E"
              Background="#1A1A2E"
              Foreground="#E0E0E0"
              BorderBrush="#3A3A5C"
              RowBackground="Transparent"
              AlternatingRowBackground="#1F1F2E"
              RowHeight="84"
              SelectionMode="Extended"
              SelectionUnit="FullRow">
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background"       Value="#252540"/>
          <Setter Property="Foreground"       Value="#E8E8F0"/>
          <Setter Property="FontWeight"       Value="SemiBold"/>
          <Setter Property="FontSize"         Value="12"/>
          <Setter Property="Padding"          Value="10,8"/>
          <Setter Property="BorderBrush"      Value="#3A3A5C"/>
          <Setter Property="BorderThickness"  Value="0,0,1,1"/>
          <Setter Property="HorizontalContentAlignment" Value="Left"/>
          <Setter Property="Cursor"           Value="Hand"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="DataGridColumnHeader">
                <Grid Background="{TemplateBinding Background}">
                  <Border BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                    <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center"/>
                      <TextBlock x:Name="SortArrow" Margin="6,0,0,0" FontSize="10"
                                 Foreground="#7C6FF7" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="SortDirection" Value="Ascending">
                    <Setter TargetName="SortArrow" Property="Text" Value="↑"/>
                  </Trigger>
                  <Trigger Property="SortDirection" Value="Descending">
                    <Setter TargetName="SortArrow" Property="Text" Value="↓"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E2E48"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </DataGrid.ColumnHeaderStyle>

      <!-- Group header rendered when the user picks a Group-by option. The
           Name is the group key (e.g. "StarWars"), ItemCount is the row count
           in that group. -->
      <DataGrid.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <Border Background="#252540" Padding="10,6" Margin="0,6,0,0"
                      BorderBrush="#3A3A5C" BorderThickness="0,0,0,1">
                <TextBlock>
                  <Run Text="{Binding Name}" FontWeight="SemiBold" Foreground="#E8E8F0"/>
                  <Run Text="  ·  " Foreground="#5A5A7C"/>
                  <Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="#9090B0"/>
                  <Run Text=" tag(s)" Foreground="#9090B0"/>
                </TextBlock>
              </Border>
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </DataGrid.GroupStyle>
      <DataGrid.CellStyle>
        <Style TargetType="DataGridCell">
          <Setter Property="Background"      Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding"         Value="6,4"/>
          <Setter Property="Foreground"      Value="#E0E0E0"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="#2E2E48"/>
              <Setter Property="Foreground" Value="#E0E0E0"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </DataGrid.CellStyle>

      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Thumbnail" Width="140" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid>
                <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" Margin="4"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                  <Image.ToolTip>
                    <Image Source="{Binding ThumbnailImage}" Width="420"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Image.ToolTip>
                </Image>
                <Border Background="#252540" CornerRadius="4" Margin="4"
                        Visibility="{Binding HasThumbnail, Converter={StaticResource InvBoolToVis}}">
                  <TextBlock Text="(no thumbnail)" Foreground="#9090B0"
                             FontSize="10" FontStyle="Italic"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="Tag name" Width="180"
                            Binding="{Binding TagName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SortMemberPath="TagName" CanUserSort="True"/>

        <DataGridTemplateColumn Header="Source" Width="*" IsReadOnly="True" SortMemberPath="SourceFile">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚠" Foreground="#E06C6C" Margin="0,0,6,0"
                           VerticalAlignment="Center" FontSize="14"
                           ToolTip="Source file no longer exists on disk"
                           Visibility="{Binding SourceMissing, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding SourceFile}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SourceFile}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="At"    Width="80"  IsReadOnly="True"
                            Binding="{Binding PositionLabel}"
                            SortMemberPath="PositionSeconds"/>
        <DataGridTextColumn Header="Added" Width="140" IsReadOnly="True"
                            Binding="{Binding AddedAtLabel}"
                            SortMemberPath="AddedAt"/>

        <DataGridTemplateColumn Header="" Width="80" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="Delete" Padding="8,2" Cursor="Hand"
                      Background="#E06C6C" Foreground="White" BorderThickness="0"
                      Click="DeleteOne_Click"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" x:Name="StatusLine"
                 Foreground="#9090B0" FontSize="12" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="Close" Padding="20,6" Cursor="Hand"
              Background="#3A3A5C" Foreground="#E0E0E0" BorderThickness="0"
              Click="Close_Click"/>
    </Grid>
  </Grid>
</Window>
